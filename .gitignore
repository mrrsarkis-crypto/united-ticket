# Dependencies / build
node_modules/
.wrangler/
.dev.vars
dist/
.tmp-fnbuild/

# OS junk
Thumbs.db
.DS_Store

# Local env / secrets — never commit these
.env
.env.*
!.env.example

# Backups
*.bak*
android-app/backup-*/

# Android build artifacts (never commit)
android-app/.gradle/
android-app/app/build/
android-app/build/
android-app/app-release-signed.apk
android-app/app-release-signed.apk.idsig
android-app/app-release-unsigned-aligned.apk

# Android signing secrets — never commit keystores
*.keystore
*.jks
*.p12
